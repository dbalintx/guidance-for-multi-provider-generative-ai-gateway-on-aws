# Copy to deploy/terraform.tfvars and edit. deploy/deploy.sh passes this one
# file to both root modules (terraform/foundation and terraform/app); every
# variable is documented in the owning module's variables.tf. The values shown
# commented out are the defaults.
#
# A variable only one root declares makes the other root print a harmless
# "Value for undeclared variable" warning (Terraform folds repeats into
# "...and N other similar warnings"). That is expected with one shared file;
# the variable still reaches the root that declares it.
#
# The app's network/data inputs (vpc_id, subnets, vpc_cidr, endpoints, secret
# ARNs, kms_key_arn, rds_instance_identifier, redis_replication_group_id,
# redis_num_cache_clusters, vpn_security_group_id) are NOT set here: deploy.sh
# wires them from `terraform output -json` of the foundation, and those values
# win over this file.
#
# Secrets NEVER go in this file: secret-valued inputs take Secrets Manager
# ARNs, and no script reads or prints a secret value.

# --- Both root modules ---
deployment_name = "llmgw" # prefix for every resource; unique per deployment in the account
tags            = {}      # your own tags, merged into the defaults
# public_mode         = false # true: internet-facing ALB with WAF (foundation adds public subnets)
# deletion_protection = true  # RDS + ALB protection, buckets kept; set false + deploy before undeploying
# kms_key_arn         = null  # optional customer KMS key (key policy: docs/fresh-account-notes.md)
# log_retention_days  = 90    # foundation: VPC flow logs + VPN logs; app: LiteLLM logs + S3 log buckets

# --- foundation: network (leave vpc_id unset to create a VPC) ---
# vpc_cidr                        = "10.0.0.0/16" # created VPC only; /24 or larger
# disable_outbound_network_access = false         # no-internet mode: no IGW/NAT, VPC endpoints only (ghcr.io image pull needs egress — see notes)
# egress_proxy_configured         = false         # only silences the no-egress warning

# --- foundation: bring your own VPC ---
# vpc_id                               = "vpc-0123456789abcdef0"
# private_subnet_ids                   = ["subnet-...", "subnet-..."] # 2+ private subnets in different AZs
# public_subnet_ids                    = []    # public mode: 2+ public subnets in different AZs
# create_vpc_endpoints_in_existing_vpc = false # also create the interface/gateway endpoints
# max_gateway_instances                = 4     # free-IP check only (rolling deploys need twice this)

# --- foundation: extra data-store clients (any non-ECS consumer, e.g. pods on an EKS cluster) ---
# extra_data_ingress_security_group_ids = []
# extra_data_ingress_cidrs              = []

# --- foundation: data stores ---
# db_engine_version           = "17"
# rds_instance_class          = "db.t3.small"
# rds_allocated_storage       = 20 # GB
# db_backup_retention_days    = 30
# redis_node_type             = "cache.t3.micro"
# redis_num_cache_clusters    = 2 # Multi-AZ needs 2+
# secret_recovery_window_days = 7 # 0 deletes immediately (test deployments only)

# --- foundation: demo Client VPN (trials only; run deploy/setup-vpn.sh certs first) ---
# create_vpn                      = false
# vpn_server_certificate_arn      = null # required with create_vpn
# vpn_client_root_certificate_arn = null # required with create_vpn
# vpn_client_cidr                 = "10.250.0.0/22" # /12../22, must not overlap the VPC
# vpn_egress_ports                = [443]           # [443, 80] for an allow_insecure_http trial

# --- app: TLS and DNS ---
# certificate_arn     = "arn:aws:acm:..." # required unless allow_insecure_http
# allow_insecure_http = false             # private proof of concept only; rejected in public mode
# hosted_zone_id      = null              # set both or neither
# record_name         = null              # e.g. "llm.example.com"

# --- app: who may reach the ALB in private mode ---
# client_cidrs              = [] # empty = the VPC CIDR only; listed ranges replace it
# client_security_group_ids = [] # extra source security groups (the demo VPN is added automatically)

# --- app: identity provider (ALB sign-in in front of the UI, both modes; needs HTTPS) ---
# identity_provider = {
#   issuer                 = "https://login.microsoftonline.com/<tenant>/v2.0"
#   authorization_endpoint = "https://login.microsoftonline.com/<tenant>/oauth2/v2.0/authorize"
#   token_endpoint         = "https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token"
#   user_info_endpoint     = "https://graph.microsoft.com/oidc/userinfo"
#   client_id              = "00000000-0000-0000-0000-000000000000"
#   client_secret_arn      = "arn:aws:secretsmanager:..." # the ARN, never the secret
# }

# --- app: licence (null = reduced mode, trials only) ---
# litellm_license_secret_arn = null

# --- app: tasks and scaling ---
# architecture                      = "arm" # or "x86"
# vcpus                             = 2     # memory is 2 GiB per vCPU
# desired_capacity                  = 2     # at creation only; auto scaling owns it afterwards
# min_capacity                      = 2
# max_capacity                      = 4
# cpu_target_utilization_percent    = 75
# memory_target_utilization_percent = 70
# run_migrations_on_apply           = true # one-off migration task gates the service rollout

# --- app: LiteLLM config and environment ---
# log_level              = "INFO" # DEBUG logs prompts: temporary troubleshooting only
# config_override_file   = null   # YAML merged over the rendered config
# extra_environment      = {}     # non-secret env vars, e.g. { HTTPS_PROXY = "http://proxy:3128" }
# provider_secret_arns   = {}     # e.g. { OPENAI_API_KEY = "arn:aws:secretsmanager:..." }

# --- app: Bedrock permissions ---
# bedrock_model_allowlist  = [] # empty = any model / inference profile
# bedrock_region_allowlist = [] # empty = any region
# cross_account_role_arns  = [] # explicit role ARNs; wildcards rejected

# --- app: WAF (public mode) and alarms ---
# waf_rate_limit_per_5_min = 2000
# alarm_email              = null # subscribed to the alarm topic; confirm from the email
